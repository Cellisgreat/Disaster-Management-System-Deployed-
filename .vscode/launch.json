{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug web server (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/DisasterManagementServer.exe",
      "args": ["--port", "8080"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "Enable pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "Build (MinGW-w64 / g++)"
    }
  ]
}
